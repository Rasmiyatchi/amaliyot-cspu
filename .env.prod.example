# Production environment — VPS deploy uchun
# Bu fayldan nusxa olib `.env.prod` qiling, qiymatlarni almashtiring.
# .env.prod ni HECH QACHON git ga qo'shmang.

# ─── Domains ──────────────────────────────────────────────────────
APP_URL=https://chdpu.example.uz
WEB_URL=https://chdpu.example.uz
VITE_API_URL=/api

# Sahifa kelishi mumkin bo'lgan domenlar (vergul bilan ajratilgan)
CORS_ORIGINS=https://chdpu.example.uz,https://qr.chdpu.example.uz

# ─── Database ─────────────────────────────────────────────────────
POSTGRES_DB=chdpu
POSTGRES_USER=chdpu
# Generatsiya: `openssl rand -base64 24`
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ─── Security ─────────────────────────────────────────────────────
# Generatsiya: `openssl rand -hex 32`
SECRET_KEY=CHANGE_ME_to_64_hex_chars_min
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ─── Super Admin (birinchi seed) ──────────────────────────────────
SUPERADMIN_USERNAME=superadmin
# Generatsiya: parol manageri yoki `openssl rand -base64 18`
SUPERADMIN_PASSWORD=CHANGE_ME_strong_admin_password
SUPERADMIN_EMAIL=admin@chdpu.uz
