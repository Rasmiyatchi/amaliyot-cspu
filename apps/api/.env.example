# Backend env — `apps/api/.env` da nusxa qiling.

# App
APP_NAME="Internship CHDPU"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
WEB_URL=http://localhost:5173

# Database (asyncpg)
DATABASE_URL=postgresql+asyncpg://chdpu:chdpu_dev@localhost:5432/chdpu_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# Generatsiya: openssl rand -hex 32
SECRET_KEY=dev-only-change-me-min-16-chars-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Super admin seed
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=SuperSecret123!
SUPERADMIN_EMAIL=admin@chdpu.uz
