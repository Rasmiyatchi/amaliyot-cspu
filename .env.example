# ─── App ──────────────────────────────────────────────────
APP_NAME=Internship CHDPU
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
WEB_URL=http://localhost:5173

# ─── Database (Postgres) ──────────────────────────────────
POSTGRES_USER=chdpu
POSTGRES_PASSWORD=chdpu_dev
POSTGRES_DB=chdpu_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chdpu:chdpu_dev@localhost:5432/chdpu_dev

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ─────────────────────────────────────────────
SECRET_KEY=change-me-in-prod-use-openssl-rand-hex-32
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
ENCRYPTION_KEY=change-me-32-bytes-base64

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Super Admin seed ─────────────────────────────────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=SuperSecret123!
SUPERADMIN_EMAIL=admin@chdpu.uz
